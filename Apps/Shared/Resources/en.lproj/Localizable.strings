/* Onboarding */
"onboarding.welcome.body" = "A quiet way of noticing how place, time and direction sit with you. Set it up once, then let your watch respond as you move.";
"onboarding.birthDate.title" = "When were you born?";
"onboarding.birthDate.note" = "Your Four Pillars are read from the sun's position, so the date matters more than the calendar it was written on.";
"onboarding.birthTime.title" = "What time?";
